generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Agent {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  password      String
  role          String         @default("agent") // admin | agent
  language      String         @default("th") // th | en
  status        String         @default("online") // online | offline | break
  avatarUrl     String?        // profile picture, stored as a file path via imageStorage.js (same pattern as message/quick-reply images) — never a raw base64 blob in the DB
  createdAt     DateTime       @default(now())
  conversations Conversation[]
  channels      AgentChannel[]
  messageViews  MessageView[]
  sentMessages  Message[]      @relation("MessageSender")
  // Purely organizational grouping (e.g. by team/department), same pattern as
  // LineChannel.categoryId below — admin creates a category by typing a name,
  // then assigns each teammate to at most one. Independent of `role`, which
  // still controls actual permissions.
  categoryId    String?
  category      AgentCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  broadcastCampaigns BroadcastCampaign[]
  upsellSubmissions UpsellSubmission[] @relation("UpsellSubmitter")
  upsellReviews     UpsellSubmission[] @relation("UpsellReviewer")
  quickReplyRequests QuickReplyRequest[] @relation("QuickReplyRequester")
  quickReplyReviews  QuickReplyRequest[] @relation("QuickReplyReviewer")
  quickReplyAuditLogs QuickReplyAuditLog[]
  conversationNotes ConversationNote[]

  @@index([categoryId])
}

// "หมวดหมู่ทีมงาน" — mirrors ChannelCategory exactly, but for grouping teammates
// on the Settings > Team page instead of LINE OA channels. Deleting a category
// doesn't delete its members (onDelete: SetNull above).
model AgentCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0) // display position, admin-controlled via up/down reorder buttons
  createdAt DateTime @default(now())
  agents    Agent[]
}

model LineChannel {
  id                         String         @id @default(cuid())
  name                       String
  channelId                  String         @unique
  channelSecret              String
  accessToken                String
  lineId                     String?        // the public @handle customers use to add the OA as a friend
  pictureUrl                 String?
  webhookRedeliveryConfirmed Boolean        @default(false) // agent manually confirms they enabled this in LINE console (no API to check it)
  // "ปิดใช้งาน" (soft-disable) — stops new incoming webhook events from being
  // processed and blocks sending new messages through this channel, but keeps
  // every existing conversation/message/tag intact and reversible by flipping
  // this back to true. Deliberately separate from the hard DELETE below (which
  // cascades and permanently destroys all of it) — this is the safe default
  // action for "we're done with this LINE OA for now."
  active                     Boolean        @default(true)
  createdAt                  DateTime       @default(now())
  conversations              Conversation[]
  agents                     AgentChannel[]
  quickReplyCategories       QuickReplyCategory[]
  categoryId                 String?
  category                   ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([categoryId])
}

// Purely organizational grouping for LINE OA channels, admin-created by typing a
// name. Shown as horizontal rows on the channel management page. A channel
// belongs to at most one category (or none — shown in an "uncategorized" row).
// Deleting a category doesn't delete its channels (onDelete: SetNull above).
// Optionally nested one level deeper under a ChannelCategoryGroup ("หมวดหมู่ใหญ่") —
// see below.
model ChannelCategory {
  id        String        @id @default(cuid())
  name      String        @unique
  createdAt DateTime      @default(now())
  channels  LineChannel[]
  groupId   String?
  group     ChannelCategoryGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([groupId])
}

// "หมวดหมู่ใหญ่" — an umbrella grouping one level above ChannelCategory ("หมวดหมู่ย่อย"),
// so several existing categories can be nested under one bigger heading on the
// channels page. Same purely-organizational, admin-typed-a-name pattern as
// ChannelCategory itself. Deleting a group doesn't delete its categories, just
// ungroups them (onDelete: SetNull above).
model ChannelCategoryGroup {
  id         String             @id @default(cuid())
  name       String             @unique
  createdAt  DateTime           @default(now())
  categories ChannelCategory[]
}

// "หมวดหมู่" — a free-form group an admin creates by typing a name (e.g. "ทักทายลูกค้า",
// "ปิดการขาย"). Optionally restricted to specific LINE OAs via `channels` — if a
// category has zero channels linked, it shows for every OA (same "empty = unrestricted"
// convention as AgentChannel below).
model QuickReplyCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  createdAt    DateTime      @default(now())
  quickReplies QuickReply[]
  channels     LineChannel[]
  requests     QuickReplyRequest[]
}

// A non-admin agent can't create a QuickReply directly (see quickReplies.js
// POST /, requireAdmin) — they submit a request here instead, which an
// admin reviews (อนุมัติ/แก้ไข/ไม่อนุมัติ — see PATCH /requests/:id/review)
// before it becomes a real, live QuickReply. "แก้ไข" (needs_revision) sends
// it back to the ORIGINAL REQUESTER to fix and resubmit (PATCH /requests/:id,
// requester-only, only while status is exactly needs_revision) — it doesn't
// mean the admin edits it themselves.
model QuickReplyRequest {
  id            String    @id @default(cuid())
  categoryId    String
  category      QuickReplyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  kind          String    @default("reply")
  name          String
  content       String
  imageData     String?   // legacy single-image column, superseded by `images` — kept read-only for old rows
  images        String[]  @default([]) // up to 5 stored image paths (imageStorage.js), same convention as QuickReply.images
  status        String    @default("pending") // pending | needs_revision | approved | rejected
  requestedById String
  requestedBy   Agent     @relation("QuickReplyRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewNote    String?   // admin's feedback — why it needs revision / was rejected
  reviewedById  String?
  reviewedBy    Agent?    @relation("QuickReplyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([requestedById])
}

model QuickReply {
  id         String             @id @default(cuid())
  categoryId String
  category   QuickReplyCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  kind       String             @default("reply") // "ประเภท" — fixed choice: reply | howto | promotion
  name       String             // internal shortcut name/title agents see in the picker
  content    String             // message text
  imageData  String?            // legacy single-image column, superseded by `images` — kept read-only for old rows
  images     String[]           @default([]) // up to 5 attached images, stored as file paths (imageStorage.js)
  order      Int                @default(0) // display position within its category, agent-controlled
  createdAt  DateTime           @default(now())

  @@index([categoryId])
}

// Append-only audit trail for the whole Quick Replies feature ("ประวัติ" tab)
// — who did what and when. QuickReplyRequest alone can't answer that: it only
// holds the CURRENT status/review, so e.g. an approval after an earlier
// rejection overwrites that rejection's reviewNote. Rows here are never
// updated after insert and are NOT cleaned up when their target
// QuickReply/category/request is later deleted — itemName/categoryName are
// snapshotted as plain strings specifically so an entry still reads sensibly
// after that (same reasoning as Message.senderName alongside senderId).
model QuickReplyAuditLog {
  id           String   @id @default(cuid())
  action       String   // created | updated | deleted | category_created | category_updated | category_deleted | request_submitted | request_resubmitted | request_approved | request_needs_revision | request_rejected | request_withdrawn
  itemName     String?  // snapshot of the quick reply / request's name at the time of the action
  categoryName String?  // snapshot of the category name at the time of the action
  detail       String?  // extra context — e.g. the admin's reviewNote, or which agent a request belonged to
  actorId      String?
  actor        Agent?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorName    String   // snapshotted alongside actorId so the entry still reads right if that agent account is later deleted
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([actorId])
}

// Restricts which LINE OA channels an agent is allowed to see.
// If an agent has zero rows here, they see all channels (no restriction).
model AgentChannel {
  id        String      @id @default(cuid())
  agentId   String
  agent     Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  channelId String
  channel   LineChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([agentId, channelId])
}

model Tag {
  id        String            @id @default(cuid())
  name      String            @unique
  color     String            @default("#6366f1")
  createdAt DateTime          @default(now())
  conversations ConversationTag[]
}

model ConversationTag {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tagId          String
  tag            Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([conversationId, tagId])
  @@index([tagId])
}

// One row per note an agent adds about a customer via the CustomerPanel —
// replaces the old single free-text Conversation.notes field so notes can
// accumulate over time (each kept as its own short, timestamped entry)
// instead of being one ever-growing block of text.
model ConversationNote {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  content        String
  agentId        String?
  agent          Agent?       @relation(fields: [agentId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model Conversation {
  id          String      @id @default(cuid())
  lineUserId  String
  displayName String?
  displayNameCustomized Boolean @default(false) // true once an agent manually renames the customer — stops incoming messages from reverting it to LINE's profile name
  pictureUrl  String?
  channelId   String
  channel     LineChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?      @relation(fields: [agentId], references: [id])
  status      String      @default("open") // open | pending | closed
  lifecycleStage String   @default("new") // new | contacted | qualified | negotiation | won | lost
  // Legacy single free-text note — superseded by noteEntries below (an
  // agent can now add multiple, timestamped notes instead of one block of
  // text). Left in place, unused by the UI going forward, so no historical
  // note is lost; any pre-existing value here is migrated into a first
  // ConversationNote row by seed.js's one-time backfill.
  notes       String?
  noteEntries ConversationNote[]
  // LINE gives us NO error when pushing a message to a user who has blocked
  // the OA (200 OK, message just silently never arrives) — the 'unfollow'
  // webhook event is the only real signal, so this flag is set from there
  // (see line.service.js). Also manually toggleable from the customer panel,
  // since a block that happened before this feature existed can't be detected
  // retroactively — there's no API to query current block status.
  blocked     Boolean     @default(false)
  blockedAt   DateTime?
  // Manual "watch this customer" flag, visible/settable by every role (unlike
  // `blocked` above, which is admin-only) — e.g. a history of rudeness,
  // chargebacks, or anything else the team should be cautious about before
  // replying. cautionReason holds the free-text "why".
  caution       Boolean     @default(false)
  cautionReason String?
  messages    Message[]
  tags        ConversationTag[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lastMessageAt DateTime?
  broadcastRecipients BroadcastRecipient[]
  upsellSubmissions UpsellSubmission[]

  @@unique([lineUserId, channelId])
  @@index([channelId])
  @@index([agentId])
  @@index([status])
  @@index([lastMessageAt])
}

// ---------- Broadcast ("ตามลูกค้า" follow-up broadcasts) ----------
// One BroadcastCampaign = one admin action ("send this text + these images to
// this set of customers"), regardless of how many text/image pieces or
// recipients it fans out to — see BroadcastRecipient for the per-customer
// outcome. Reply tracking is deliberately NOT a stored column here — it's
// computed on read by checking for a `sender: 'user'` Message after this
// campaign's createdAt in each recipient's conversation (see broadcasts.js),
// so it always reflects live conversation state instead of going stale.
model BroadcastCampaign {
  id              String   @id @default(cuid())
  createdById     String
  createdBy       Agent    @relation(fields: [createdById], references: [id])
  message         String?
  images          String?  // JSON array of stored "/uploads/..." paths (see imageStorage.js), null if text-only
  filters         String?  // JSON snapshot of the filter criteria used to pick recipients, for reference — null when recipients were hand-picked instead
  status          String   @default("sending") // sending | completed
  totalRecipients Int      @default(0)
  successCount    Int      @default(0)
  failedCount     Int      @default(0)
  skippedCount    Int      @default(0) // blocked customers / disabled channels, auto-excluded before any LINE call
  createdAt       DateTime @default(now())
  completedAt     DateTime?
  recipients      BroadcastRecipient[]

  @@index([createdById])
}

// One row per customer targeted by a campaign — records the actual outcome for
// that customer, independent of how many Message rows the send produced.
model BroadcastRecipient {
  id             String   @id @default(cuid())
  campaignId     String
  campaign       BroadcastCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  status         String   // sent | failed | skipped_blocked | skipped_channel_inactive
  error          String?
  sentAt         DateTime?
  createdAt      DateTime @default(now())

  @@index([campaignId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String       // user | agent | bot
  senderName     String?
  senderId       String?      // Agent.id who sent this (only set for sender: 'agent'). Nullable — existing
                               // rows from before this field was added stay null; not backfilled.
  senderAgent    Agent?       @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  type           String       @default("text") // text | image | sticker | audio | video | location
  content        String
  metadata       String?      // JSON string for images, stickers etc
  imageData      String?      // base64 data URL for images an agent attached & sent (LINE fetches it via a public route)
  read           Boolean      @default(false)
  lineMessageId  String?      @unique // LINE's own message id — used to reject duplicate webhook redeliveries
  createdAt      DateTime     @default(now())
  views          MessageView[]
  upsellItems    UpsellSubmissionItem[]

  // AI moderation result (see moderation.service.js) — only ever checked for
  // freely-typed agent text messages sent to a customer via the composer, and
  // only going forward from when this feature shipped (no historical backfill).
  // Powers the admin-only Report page used for KPI review.
  flagged        Boolean      @default(false)
  flagSeverity   String?      // "minor" | "severe" — only set when flagged
  flagReason     String?      // short Thai explanation from the AI, shown on the Report page
  // Which check flagged this — "moderation" (bad words/spam, moderation.service.js)
  // or "link" (unauthorized link, linkGuard.js). Null for rows flagged before
  // this field existed — the ตรวจสอบ report treats null the same as "moderation"
  // for display, since that's the only category that existed back then.
  flagCategory   String?

  @@index([conversationId, createdAt])
  @@index([flagged])
}

// Audit trail for customer messages: which agents opened the conversation while
// this was the newest customer message, and did NOT end up being the one who
// replied. Only ever attached to the single most-recent customer message at
// view time — older messages keep whatever names they already accumulated
// (they're frozen once superseded by a newer message or answered).
// Admin-only: agents' API responses never include this relation at all (see
// messages.js), not just hidden in the UI, so there's no way for an agent to
// see who else has been avoiding a reply.
model MessageView {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  viewedAt  DateTime @default(now())

  @@unique([messageId, agentId])
  @@index([messageId])
}

// Admin-registered domains an agent is allowed to send a customer — anything
// else found in an outgoing agent text message gets flagged (see
// backend/src/lib/linkGuard.js), so a supervisor can catch an agent quietly
// steering a customer toward an unauthorized site. Matching is domain-based
// (a message linking to any subdomain of an approved domain is fine), not
// exact-URL, so path/query params on an otherwise-approved link never
// trigger a false flag.
model ApprovedLink {
  id        String   @id @default(cuid())
  domain    String   @unique
  label     String?
  createdAt DateTime @default(now())
}

// ---------- Upsell ("อัพเซลล์") submissions ----------
// An agent picks one or more messages/images from a chat as proof of a
// successful upsell and submits them together as one UpsellSubmission for a
// reviewer to score. The exclusivity rule ("ข้อความอัพเซลล์เป็นของใครของมัน" —
// once claimed, nobody else can claim the same message) is enforced by the
// @unique on UpsellSubmissionItem.messageId below, not just client-side UI —
// a second agent's submit attempt hits a real DB constraint violation.
model UpsellSubmission {
  id             String    @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  agentId        String
  agent          Agent     @relation("UpsellSubmitter", fields: [agentId], references: [id])
  status         String    @default("pending") // pending | approved | rejected
  amount         Float?    // baht, filled in by the reviewer alongside the ผ่าน/ไม่ผ่าน decision
  reviewNote     String?
  reviewedById   String?
  reviewedBy     Agent?    @relation("UpsellReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  items          UpsellSubmissionItem[]

  @@index([agentId])
  @@index([status])
}

// One row per claimed message, one row per submission attempt (not
// necessarily one per message anymore — see below). The exclusivity lock is
// enforced in application code (POST /api/upsells in upsells.js), not by a DB
// unique constraint on messageId: a message that was claimed and then
// rejected must become claimable again (so an agent who picked the wrong
// message can redo it), while a message still pending/approved must not be.
// A plain @unique on messageId can't express "unique only among
// pending/approved rows," so the rejected row is instead just left in place
// as history and the new claim gets its own row.
model UpsellSubmissionItem {
  id           String   @id @default(cuid())
  submissionId String
  submission   UpsellSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  messageId    String
  message      Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([submissionId])
  @@index([messageId])
}
